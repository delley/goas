          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/example.FooBody"
              }
            }
          },
          "required": true
        }
      },
      "put": {
        "responses": {
          "200": {
            "description": "Successful foo response",
            "content": {
              "application/json": {
