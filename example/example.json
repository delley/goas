  "components": {
    "schemas": {
      "Birb": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "airspeedVelocity": {
            "type": "number"
          }
        }
      },
      "example.Animal": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "example.BsonID": {
        "type": "string"
      },
      "example.DoubleAlias": {
        "$ref": "#/components/schemas/example.JsonMap"
      },
      "example.Environment": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "example.FooBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "Example": {
            "$ref": "#/components/schemas/example.DoubleAlias"
          },
          "required": {
            "type": "boolean"
          },
          "arrayEnum": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "example1",
                "example2"
              ]
            }
          }
        }
      },
      "example.FooMergePatch": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "example.FooPatchOperation": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "example.FooPatchOperationSet": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/example.FooPatchOperation"
            }
          }
        }
      },
      "example.FooResponse": {
        "type": "object",
        "properties": {
          "bsonId": {
            "$ref": "#/components/schemas/example.BsonID"
          },
          "id": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "uniqueId": {
            "type": "string",
            "format": "uuid"
          },
          "endDate": {
            "$ref": "#/components/schemas/example.UnixMillis"
          },
          "count": {
            "type": "integer",
            "format": "int64",
            "example": 6
          },
          "msg": {},
          "foo": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/example.InnerFoo"
            }
          },
          "environments": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/example.Environment"
            }
          },
          "freeForm": {},
          "jsonMap": {
            "$ref": "#/components/schemas/example.JsonMap"
          },
          "doubleAlias": {
            "$ref": "#/components/schemas/example.DoubleAlias"
          },
          "interfaceBlah": {
            "$ref": "#/components/schemas/example.InterfaceResponse"
          },
          "instruction": {
            "$ref": "#/components/schemas/example.Instruction"
          },
          "bsonPtr": {
            "example": "blah blah blah",
            "$ref": "#/components/schemas/example.BsonID"
          },
          "randomBool": {
            "type": "boolean",
            "example": true
          },
          "myEnum": {
            "type": "string",
            "enum": [
              "value1",
              "value2"
            ]
          },
          "changeReturn": {
            "$ref": "#/components/schemas/example.Instruction"
          }
        }
      },
      "example.InnerFoo": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string"
          },
          "b": {
            "type": "string"
          }
        }
      },
      "example.Instruction": {
        "type": "object",
        "additionalProperties": {}
      },
      "example.InterfaceResponse": {
        "type": "object",
        "additionalProperties": {}
      },
      "example.JsonMap": {
        "type": "object",
        "additionalProperties": {}
      },
      "example.UnixMillis": {
        "type": "integer",
        "format": "int64"
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      }
    }
