    "/api/v2/foo-spaces": {
      "get": {
        "responses": {
          "200": {
            "description": "Successful foo response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/example.FooResponse"
                }
              }
            }
